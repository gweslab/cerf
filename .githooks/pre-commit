#!/bin/bash

checklist_dir="$(cd "$(dirname "$0")/.." && pwd)/docs/ai_checklists"
if [ -d "$checklist_dir" ]; then
    checklist_names=$(find "$checklist_dir" -type f -name '*.md' | sed 's|.*/||' | sort -u)
    if [ -n "$checklist_names" ]; then
        added=$(git diff --cached -U0 | grep -E '^\+[^+]' || true)
        if [ -n "$added" ]; then
            leaks=$(printf '%s\n' "$added" | grep -oFf <(printf '%s\n' "$checklist_names") | sort -u || true)
            if [ -n "$leaks" ]; then
                echo "Checklist filenames in staged diff:"
                printf '%s\n' "$leaks" | sed 's/^/  /'
                exit 1
            fi
        fi
    fi
fi

MAX_LINES=500
FAIL=0

for file in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp|cc|c|py)$' | grep -v 'tracing/' | grep -v '^\.claude/hooks/' | grep -v '_data\.h$'); do
    if [ -f "$file" ]; then
        lines=$(wc -l < "$file" | tr -d ' ')
        if [ "$lines" -gt "$MAX_LINES" ]; then
            echo "$file: $lines lines (max $MAX_LINES)"
            FAIL=1
        fi
    fi
done

exit $FAIL
