cmake_policy(SET CMP0009 NEW)
file(GLOB_RECURSE cerfqt_bundled LIST_DIRECTORIES false RELATIVE "${CERFQT_BUNDLED_DIR}"
     "${CERFQT_BUNDLED_DIR}/*")
foreach(cerfqt_file IN LISTS cerfqt_bundled)
    if(cerfqt_file MATCHES "(^|/)\\.git(/|$)|(^|/)\\.gitkeep$|\\.(i64|id0|id1|id2|nam|til|cmd)$")
        continue()
    endif()
    set(cerfqt_src "${CERFQT_BUNDLED_DIR}/${cerfqt_file}")
    set(cerfqt_dst "${CERFQT_OUTPUT_DIR}/${cerfqt_file}")
    get_filename_component(cerfqt_dir "${cerfqt_dst}" DIRECTORY)
    file(MAKE_DIRECTORY "${cerfqt_dir}")
    if(IS_SYMLINK "${cerfqt_src}")
        file(READ_SYMLINK "${cerfqt_src}" cerfqt_target)
        set(cerfqt_current "")
        if(IS_SYMLINK "${cerfqt_dst}")
            file(READ_SYMLINK "${cerfqt_dst}" cerfqt_current)
        endif()
        if(NOT cerfqt_current STREQUAL cerfqt_target)
            file(REMOVE_RECURSE "${cerfqt_dst}")
            file(CREATE_LINK "${cerfqt_target}" "${cerfqt_dst}" SYMBOLIC)
        endif()
        continue()
    endif()
    file(COPY_FILE "${cerfqt_src}" "${cerfqt_dst}" ONLY_IF_DIFFERENT)
    if(cerfqt_file MATCHES "\\.sh$")
        file(CHMOD "${cerfqt_dst}"
             FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                              GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
endforeach()
file(COPY_FILE "${CERFQT_DB_JSON}" "${CERFQT_OUTPUT_DIR}/${CERFQT_DB_JSON_NAME}" ONLY_IF_DIFFERENT)
