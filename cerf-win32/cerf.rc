#include <winver.h>
#include <cerffrontend/version.h>

APPICON ICON "../assets/cerf_running.ico"
1 ICON "../assets/cerf_running.ico"
2 ICON "../assets/suspend.ico"

/* built from assets/icons_sources/*.svg by tools/make_icons.py. */
ga_autoresize               ICON "../assets/ga_autoresize.ico"
ga_autoresize_disabled      ICON "../assets/ga_autoresize_disabled.ico"
lock_on                     ICON "../assets/lock_on.ico"
lock_off                    ICON "../assets/lock_off.ico"
ga_cursor                   ICON "../assets/ga_cursor.ico"
cursor                      ICON "../assets/cursor.ico"
stylus                      ICON "../assets/stylus.ico"
display                     ICON "../assets/display.ico"
keyboard                    ICON "../assets/keyboard.ico"
ga_keyboard                 ICON "../assets/ga_keyboard.ico"
speaker                     ICON "../assets/speaker.ico"
speaker_active              ICON "../assets/speaker_active.ico"
pcmcia                      ICON "../assets/pcmcia.ico"
pcmcia_enabled              ICON "../assets/pcmcia_enabled.ico"
pcmcia_enabled_cf           ICON "../assets/pcmcia_enabled_cf.ico"
pcmcia_enabled_ethernet     ICON "../assets/pcmcia_enabled_ethernet.ico"
pcmcia_enabled_vga          ICON "../assets/pcmcia_enabled_vga.ico"
pcmcia_enabled_ram          ICON "../assets/pcmcia_enabled_ram.ico"
pcmcia_enabled_serial_com   ICON "../assets/pcmcia_enabled_serial_com.ico"
pcmcia_enabled_serial_modem ICON "../assets/pcmcia_enabled_serial_modem.ico"
serial                      ICON "../assets/serial.ico"
serial_com                  ICON "../assets/serial_com.ico"
serial_modem                ICON "../assets/serial_modem.ico"
usb                         ICON "../assets/usb.ico"
usb_ford_flasher            ICON "../assets/usb_ford_flasher.ico"
sd_map                      ICON "../assets/sd_map.ico"
car                         ICON "../assets/car.ico"
ilp_diagnostics             ICON "../assets/ilp_diagnostics.ico"
ilp_diagnostics_rejected    ICON "../assets/ilp_diagnostics_rejected.ico"

CERF_LOGO        RCDATA "../assets/cerf_1024.png"

FONT_PLEX_SANS           RCDATA "../assets/fonts/IBMPlexSans-Regular.ttf"
FONT_PLEX_SANS_BOLD      RCDATA "../assets/fonts/IBMPlexSans-Bold.ttf"
FONT_PLEX_MONO_BOLD      RCDATA "../assets/fonts/IBMPlexMono-Bold.ttf"

/* about_band_*.png built from assets/icons_sources/about_band.svg by
   tools/make_icons.py --targets band; picked per-DPI at runtime. */
ABOUT_BAND_100   RCDATA "../assets/about_band_100.png"
ABOUT_BAND_125   RCDATA "../assets/about_band_125.png"
ABOUT_BAND_150   RCDATA "../assets/about_band_150.png"
ABOUT_BAND_200   RCDATA "../assets/about_band_200.png"
ABOUT_BAND_300   RCDATA "../assets/about_band_300.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CERF_VERSION_MAJOR,CERF_VERSION_MINOR,CERF_VERSION_PATCH,CERF_VERSION_BUILD_WORD
 PRODUCTVERSION CERF_VERSION_MAJOR,CERF_VERSION_MINOR,CERF_VERSION_PATCH,CERF_VERSION_BUILD_WORD
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Yaroslav Kibysh"
            VALUE "FileDescription",  "CE Runtime Foundation"
            VALUE "FileVersion",      CERF_VERSION_DISPLAY_STR
            VALUE "InternalName",     "cerf"
            VALUE "LegalCopyright",   "Copyright (c) Yaroslav Kibysh"
            VALUE "OriginalFilename", "cerf.exe"
            VALUE "ProductName",      "CE Runtime Foundation"
            VALUE "ProductVersion",   CERF_VERSION_DISPLAY_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
