#include <windows.h>
#include "uninstall_resource.h"
#include "asset_icon_files.h"

#define CERF_DIALOG_STYLE STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
#define CERF_DIALOG_FONT  FONT 9, "Segoe UI", 400, 0, 0x1

IDI_UNINSTALL ICON CERF_ERROR_ICON_FILE

IDD_CONFIRM DIALOGEX 0, 0, 300, 128
CERF_DIALOG_STYLE
CERF_DIALOG_FONT
BEGIN
    ICON            IDI_UNINSTALL, IDC_DIALOG_ICON, 10, 10, 20, 20
    LTEXT           "", IDC_HEADING, 40, 12, 252, 10
    LTEXT           "", IDC_PATH, 40, 28, 252, 18
    AUTOCHECKBOX    "", IDC_DELETE_DATA, 40, 52, 252, 12
    LTEXT           "", IDC_HINT, 40, 66, 252, 26
    DEFPUSHBUTTON   "", IDOK, 184, 106, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 106, 52, 15
END

IDD_PROGRESS DIALOGEX 0, 0, 300, 172
CERF_DIALOG_STYLE
CERF_DIALOG_FONT
BEGIN
    ICON            IDI_UNINSTALL, IDC_DIALOG_ICON, 10, 10, 20, 20
    LTEXT           "", IDC_HEADING, 40, 12, 252, 10
    EDITTEXT        IDC_LOG, 40, 28, 252, 118, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "", IDOK, 240, 150, 52, 15
END

#include "uninstall_name_text.h"
#include "../cerf-qt/executable_names_text.h"
#define CERF_RC_DESCRIPTION CERF_UNINSTALL_NAME
#define CERF_RC_FILE_NAME   CERF_UNINSTALLER_NAME
#include "../cerf-qt/version_info.rc"
